    "code": "NGFF-CT-015",
    "slug": "transform-params-match-ndim",
    "level": "MUST",
    "versions": [
      "0.6",
      "0.9.dev1"
    ],
    "spec": "https://github.com/ome/ngff-spec/blob/0.6/index.md?plain=1#L422",
    "summary": "A transformation's parameters fit the dimensionality of its input and output.",
    "example": {
      "ome": {
        "version": "0.6",
        "scene": {
          "coordinateSystems": [
            {
              "name": "a",
              "axes": [
                {
                  "name": "y",
                  "type": "space"
                },
                {
                  "name": "x",
                  "type": "space"
                }
              ]
            },
            {
              "name": "b",
              "axes": [
                {
                  "name": "z",
                  "type": "space"
                },
                {
                  "name": "y",
                  "type": "space"
                },
                {
                  "name": "x",
                  "type": "space"
                }
              ]
            }
          ],
          "coordinateTransformations": [
            {
              "input": {
                "name": "a"
              },
              "output": {
                "name": "b"
              },
              "type": "identity"
            }
          ]
        }
      }
    }
  },
