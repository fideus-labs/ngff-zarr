{
  "name": "@fideus-labs/ngff-zarr",
  "version": "0.28.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./browser": "./src/browser-mod.ts",
    "./methods/itkwasm": "./src/methods/itkwasm.ts",
    "./methods/itkwasm-browser": "./src/methods/itkwasm-browser.ts",
    "./methods/itkwasm-node": "./src/methods/itkwasm-node.ts"
  },
  "tasks": {
    "dev": "deno run --allow-all src/mod.ts",
    "dev:server": "deno run --allow-all test/browser/server.ts",
    "test": "deno test --allow-all --ignore=test/browser-npm/,test/node/",
    "test:browser": "node scripts/run_playwright.mjs",
    "test:browser:ui": "node scripts/run_playwright.mjs --ui",
    "test:browser:debug": "node scripts/run_playwright.mjs --debug",
    "test:browser:bundle": "deno task build:bundle && deno task test:browser",
    "test:browser:npm": "deno task build:npm && deno task test:browser",
    "test:node": "deno task build:npm && node --test \"test/node/*.test.mjs\"",
    "test:all": "deno task test && deno task test:node && deno task test:browser:bundle",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check src/mod.ts",
    "build": "deno run --allow-all scripts/build.ts",
    "build:npm": "deno run --allow-all scripts/build_npm.ts",
    "build:bundle": "deno run --allow-all scripts/build_npm.ts && deno run --allow-all scripts/inline_worker.ts && cd npm && npx esbuild esm/browser-mod.js --bundle --format=esm --platform=browser --minify --outfile=../test/browser-npm/ngff-zarr.bundle.js"
  },
  "imports": {
    "@itk-wasm/compare-images": "npm:@itk-wasm/compare-images@^5.4.1",
    "@itk-wasm/downsample": "npm:@itk-wasm/downsample@^2.0.2",
    "@itk-wasm/image-io": "npm:@itk-wasm/image-io@^1.6.0",
    "@std/assert": "jsr:@std/assert@^1.0.18",
    "@std/cli": "jsr:@std/cli@^1.0.27",
    "@std/http": "jsr:@std/http@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.4",
    "@fideus-labs/fizarrita": "npm:@fideus-labs/fizarrita@^2.0.0",
    "@fideus-labs/worker-pool": "npm:@fideus-labs/worker-pool@^2.0.0",
    "@zarrita/storage": "jsr:@zarrita/storage@^0.1.4",
    "dnt": "jsr:@deno/dnt@^0.42.3",
    "itk-wasm": "npm:itk-wasm@^1.0.0-b.201",
    "microdiff": "npm:microdiff@^1.5.0",
    "zod": "npm:zod@^4.3.6",
    "zarrita": "jsr:@zarrita/zarrita@^0.6.1",
    "fflate": "npm:fflate@^0.8.2",
    "playwright/test": "npm:@playwright/test@^1.58.1"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": ["dist/", "test/browser-npm/"]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "exclude": ["dist/"]
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true
  },
  "nodeModulesDir": "auto",
  "publish": {
    "exclude": [".commitizen"]
  }
}
